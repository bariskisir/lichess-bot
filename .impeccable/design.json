  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled accent treatment for a main action.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Save settings</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;min-height:2.5rem;padding:0.55rem 0.9rem;border:1px solid var(--line,#2b3b31);border-radius:7px;font-family:'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;font-weight:600;font-size:0.8125rem;line-height:1.3;background:var(--surface,#18251f);color:var(--text,#e7eee8);cursor:pointer;transition:background 160ms,border-color 160ms;}.ds-button-primary:hover:not(:disabled){background:var(--hover,#24362c);border-color:var(--line-strong,#496153)}.ds-button-primary:active:not(:disabled){background:var(--selected,#294234)}.ds-button-primary:focus-visible{outline:2px solid var(--accent,#a3c7a8);outline-offset:3px}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed}.ds-button-primary{background:var(--accent,#a3c7a8);border-color:var(--accent,#a3c7a8);color:var(--on-accent,#14251a)}.ds-button-primary:hover:not(:disabled){background:var(--accent-hover,#b9d7bc);border-color:var(--accent-hover,#b9d7bc)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Default surface-and-stroke treatment for a supporting action.",
      "html": "<button type=\"button\" class=\"ds-button-secondary\">Restore defaults</button>",
      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;min-height:2.5rem;padding:0.55rem 0.9rem;border:1px solid var(--line,#2b3b31);border-radius:7px;font-family:'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;font-weight:600;font-size:0.8125rem;line-height:1.3;background:var(--surface,#18251f);color:var(--text,#e7eee8);cursor:pointer;transition:background 160ms,border-color 160ms;}.ds-button-secondary:hover:not(:disabled){background:var(--hover,#24362c);border-color:var(--line-strong,#496153)}.ds-button-secondary:active:not(:disabled){background:var(--selected,#294234)}.ds-button-secondary:focus-visible{outline:2px solid var(--accent,#a3c7a8);outline-offset:3px}.ds-button-secondary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet treatment for secondary workspace and rail actions.",
      "html": "<button type=\"button\" class=\"ds-button-ghost\">Expand</button>",
      "css": ".ds-button-ghost{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;min-height:2.5rem;padding:0.55rem 0.9rem;border:1px solid var(--line,#2b3b31);border-radius:7px;font-family:'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;font-weight:600;font-size:0.8125rem;line-height:1.3;background:var(--surface,#18251f);color:var(--text,#e7eee8);cursor:pointer;transition:background 160ms,border-color 160ms;}.ds-button-ghost:hover:not(:disabled){background:var(--hover,#24362c);border-color:var(--line-strong,#496153)}.ds-button-ghost:active:not(:disabled){background:var(--selected,#294234)}.ds-button-ghost:focus-visible{outline:2px solid var(--accent,#a3c7a8);outline-offset:3px}.ds-button-ghost:disabled{opacity:.5;cursor:not-allowed}.ds-button-ghost{background:transparent;border-color:transparent}.ds-button-ghost:hover:not(:disabled){border-color:transparent}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Danger text and hover feedback for a destructive action.",
      "html": "<button type=\"button\" class=\"ds-button-danger\">Remove account</button>",
      "css": ".ds-button-danger{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;min-height:2.5rem;padding:0.55rem 0.9rem;border:1px solid var(--line,#2b3b31);border-radius:7px;font-family:'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;font-weight:600;font-size:0.8125rem;line-height:1.3;background:var(--surface,#18251f);color:var(--text,#e7eee8);cursor:pointer;transition:background 160ms,border-color 160ms;}.ds-button-danger:hover:not(:disabled){background:var(--hover,#24362c);border-color:var(--line-strong,#496153)}.ds-button-danger:active:not(:disabled){background:var(--selected,#294234)}.ds-button-danger:focus-visible{outline:2px solid var(--accent,#a3c7a8);outline-offset:3px}.ds-button-danger:disabled{opacity:.5;cursor:not-allowed}.ds-button-danger{color:var(--danger,#efa29a)}.ds-button-danger:hover:not(:disabled){background:var(--danger-soft,#3a2726);border-color:var(--danger,#efa29a)}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "A labelled settings field with the shared stroke, surface, and keyboard focus treatment.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Search depth</span><input class=\"ds-field-input\" type=\"number\" value=\"7\" min=\"1\" aria-describedby=\"ds-field-help\"/><small class=\"ds-field-help\" id=\"ds-field-help\">Every move is searched to this depth.</small></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:.45rem;font-family:'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;color:var(--text,#e7eee8)}.ds-field-label{font-size:.8125rem;font-weight:600}.ds-field-input{border:1px solid var(--line,#2b3b31);background:var(--surface,#18251f);color:var(--text,#e7eee8);border-radius:7px;min-height:2.5rem;padding:.55rem .75rem;font-family:'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;font-size:.8125rem;max-width:100%;caret-color:var(--accent,#a3c7a8)}.ds-field-input:hover:not(:disabled){border-color:var(--line-strong,#496153)}.ds-field-input:focus-visible{outline:2px solid var(--accent,#a3c7a8);outline-offset:3px}.ds-field-input[aria-invalid=true]{border-color:var(--danger,#efa29a)}.ds-field-input:disabled{opacity:.55;cursor:not-allowed}.ds-field-help{font-size:.75rem;color:var(--muted,#a0b1a6);line-height:1.65;max-width:70ch}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "A labelled rail route with an inline SVG icon and a tabular activity count.",
      "html": "<nav class=\"ds-navigation\" aria-label=\"Sample navigation\"><a class=\"ds-navigation-item\" href=\"#games\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect width=\"7\" height=\"7\" x=\"3\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"7\" x=\"14\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"7\" x=\"14\" y=\"14\" rx=\"1\"/><rect width=\"7\" height=\"7\" x=\"3\" y=\"14\" rx=\"1\"/></svg><span>Live games</span><small>6</small></a></nav>",
      "css": ".ds-navigation{background:var(--rail,#162b22);padding:1rem}.ds-navigation-item{display:flex;align-items:center;gap:.65rem;min-height:44px;padding:.65rem .75rem;text-decoration:none;font-family:'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;font-size:.8125rem;color:var(--rail-muted,#a2b6a9);border-radius:7px;transition:background 160ms,color 160ms}.ds-navigation-item>svg{width:17px;height:17px;flex-shrink:0}.ds-navigation-item>span{flex:1}.ds-navigation-item>small{font-size:.6875rem;font-variant-numeric:tabular-nums;min-width:18px;text-align:center}.ds-navigation-item:hover{color:var(--rail-text,#e0ece3);background:var(--rail-hover,#213b2e)}.ds-navigation-item[aria-current=page]{background:var(--rail-selected,#2b4838);color:var(--rail-text,#e0ece3)}.ds-navigation-item[aria-current=page]>svg{color:var(--rail-accent,#b0cfb0)}.ds-navigation-item:focus-visible{outline:2px solid var(--accent,#a3c7a8);outline-offset:3px}"
    },
    {
      "name": "Time-Control Chip",
      "kind": "chip",
      "refersTo": "pool-chip",
      "description": "A native checkbox choice; selecting it tints the label and strengthens the border.",
      "html": "<label class=\"ds-pool-chip\"><input type=\"checkbox\" checked/><span>3+2</span></label>",
      "css": ".ds-pool-chip{display:inline-flex;gap:.4rem;align-items:center;cursor:pointer;border:1px solid var(--line,#2b3b31);padding:.5rem .7rem;border-radius:6px;background:var(--surface,#18251f);color:var(--text,#e7eee8);font-family:'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;font-size:.8125rem;font-variant-numeric:tabular-nums}.ds-pool-chip:has(input:checked){border-color:var(--accent,#a3c7a8);background:var(--selected,#294234)}.ds-pool-chip>input{accent-color:var(--accent,#a3c7a8);width:16px;height:16px;margin:0;flex-shrink:0}.ds-pool-chip>input:focus-visible{outline:2px solid var(--accent,#a3c7a8);outline-offset:3px}.ds-pool-chip:has(input:disabled){opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Game Card",
      "kind": "card",
      "refersTo": "game-card",
      "description": "Board-card structure sampled from the source. This static snippet omits raster pieces and the runtime inspector.",
      "html": "<article class=\"ds-game-card\"><div class=\"ds-game-header\"><span>3+2 · Rated · <span class=\"ds-game-id\">demo0000</span></span><span class=\"ds-game-state\">Thinking</span></div><div class=\"ds-game-player\"><strong>QuietBishop <span class=\"ds-game-rating\">1920</span></strong><span class=\"ds-game-clock ds-game-clock--active\">2:33</span></div><div class=\"ds-game-position\"><div class=\"ds-game-evaluation\"><progress class=\"ds-game-evaluation-bar\" max=\"100\" value=\"54\" title=\"+0.32\" aria-label=\"Evaluation: +0.32\"></progress></div><button class=\"ds-board\" type=\"button\" aria-label=\"Inspect sample game\"><span class=\"ds-board-square ds-board-square--light\"></span><span class=\"ds-board-square ds-board-square--dark\"></span><span class=\"ds-board-square ds-board-square--light\"></span><span class=\"ds-board-square ds-board-square--dark\"></span><span class=\"ds-board-square ds-board-square--light\"></span><span class=\"ds-board-square ds-board-square--dark\"></span><span class=\"ds-board-square ds-board-square--light\"></span><span class=\"ds-board-square ds-board-square--dark\"></span><span class=\"ds-board-square ds-board-square--dark\"></span><span class=\"ds-board-square ds-board-square--light\"></span><span class=\"ds-board-square ds-board-square--dark\"></span><span class=\"ds-board-square ds-board-square--light\"></span><span class=\"ds-board-square ds-board-square--dark\"></span><span class=\"ds-board-square ds-board-square--light\"></span><span class=\"ds-board-square ds-board-square--dark\"></span><span class=\"ds-board-square ds-board-square--light\"></span><span class=\"ds-board-square ds-board-square--light\"></span><span class=\"ds-board-square ds-board-square--dark\"></span><span class=\"ds-board-square ds-board-square--light\"></span><span class=\"ds-board-square ds-board-square--dark\"></span><span class=\"ds-board-square ds-board-square--light\"></span><span class=\"ds-board-square ds-board-square--dark\"></span><s