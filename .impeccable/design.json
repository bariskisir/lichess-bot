      "css": ".ds-game-card{min-width:0;padding:.625rem;background:var(--surface,#18251f);color:var(--text,#e7eee8);border:1px solid var(--line,#2b3b31);border-radius:12px;font-family:'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif}.ds-game-header{display:flex;justify-content:space-between;align-items:center;gap:.375rem;height:1.25rem;font-size:.6875rem}.ds-game-id{color:var(--muted,#a0b1a6);font-variant-numeric:tabular-nums}.ds-game-state{color:var(--positive,#a3c7a8);font-size:.6875rem;font-weight:600;display:inline-flex;align-items:center;gap:.3rem}.ds-game-state:before{content:\"\";width:5px;height:5px;border-radius:50%;background:currentColor}.ds-game-player{display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:.25rem 0;height:2rem;font-size:.8125rem}.ds-game-player strong{font-weight:600}.ds-game-rating{color:var(--muted,#a0b1a6);font-weight:400;font-size:.75rem;font-variant-numeric:tabular-nums}.ds-game-clock{min-width:3.25rem;text-align:center;padding:.15rem .35rem;font-size:.8125rem;font-weight:600;font-variant-numeric:tabular-nums;background:var(--surface-alt,#203028);border-radius:4px;color:var(--muted,#a0b1a6)}.ds-game-clock--active{background:var(--selected,#294234);color:var(--text,#e7eee8)}.ds-game-position{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,14fr);gap:.5rem}.ds-game-evaluation{position:relative;overflow:hidden;background:#403d39;border-radius:5px}.ds-game-evaluation-bar{appearance:none;position:absolute;inset:0;margin:0;height:100%;width:100%;writing-mode:vertical-lr;transform:rotate(180deg);background:#403d39;border:0}.ds-game-evaluation-bar::-webkit-progress-bar{background:#403d39}.ds-game-evaluation-bar::-webkit-progress-value{background:#fff}.ds-game-evaluation-bar::-moz-progress-bar{background:#fff}.ds-board{display:grid;grid-template-columns:repeat(8,1fr);grid-template-rows:repeat(8,minmax(0,1fr));width:100%;aspect-ratio:1;border:0;padding:0;border-radius:3px;overflow:hidden;cursor:pointer}.ds-board-square--light{background:var(--board-light,#dce4d1)}.ds-board-square--dark{background:var(--board-dark,#7d977c)}.ds-board:focus-visible{outline:2px solid var(--accent,#a3c7a8);outline-offset:3px}"
